{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPA Helper policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plugin_version", "policy_revision", "generated_at", "groups", "keys"],
  "properties": {
    "contract_version": {"const": "v1"},
    "plugin_version": {"enum": ["0.1.0", "0.1.1"]},
    "policy_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "generated_at": {"type": "string", "format": "date-time"},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "keys": {"type": "array", "items": {"$ref": "#/$defs/key"}}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "selector": {"type": "object", "additionalProperties": false, "required": ["source", "provider"], "properties": {"source": {"enum": ["auth-files", "ai-providers"]}, "provider": {"type": "string", "minLength": 1}}},
    "rule": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "models": {"$ref": "#/$defs/strings"}, "denied_models": {"$ref": "#/$defs/strings"},
        "credential_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "denied_credential_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "credential_providers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/selector"}},
        "denied_credential_providers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/selector"}}
      }
    },
    "group": {"type": "object", "additionalProperties": false, "required": ["id", "name", "rule"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "note": {"type": "string"}, "rule": {"$ref": "#/$defs/rule"}}},
    "key": {"type": "object", "additionalProperties": false, "required": ["id", "enabled", "group_ids", "max_concurrency", "rule"], "properties": {"id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "label": {"type": "string"}, "enabled": {"type": "boolean"}, "group_ids": {"$ref": "#/$defs/strings"}, "max_concurrency": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "rule": {"$ref": "#/$defs/rule"}}}
  }
}

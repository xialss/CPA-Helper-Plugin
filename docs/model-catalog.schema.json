{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPA Helper credential model catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plugin_version", "cpa_version", "catalog_revision", "generated_at", "credentials"],
  "properties": {
    "contract_version": {"const": "v1"},
    "plugin_version": {"const": "0.1.9"},
    "cpa_version": {"const": "v8.0.45"},
    "catalog_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "generated_at": {"type": "string", "format": "date-time"},
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "source", "provider", "enabled", "models"],
        "properties": {
          "ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "source": {"enum": ["auth-files", "ai-providers"]},
          "provider": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "models": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
